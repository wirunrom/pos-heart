{
 "$schema": "https://design-tokens.github.io/community-group/format/",
 "$description": "Tier order: primitive → semantic → component. Components reference semantic (or component) tokens only. brand.* is the ONLY place a product name/brand colour enters.",
 "brand": {
  "name": {
   "$type": "string",
   "$value": "POS Heart",
   "$description": "Working title. Shown in UI chrome only via this token."
  },
  "accent-ramp": {
   "$type": "string",
   "$value": "saffron",
   "$description": "Which primitive ramp feeds semantic accent-*. Rebrand = change this + logo asset."
  },
  "logo": {
   "$type": "asset",
   "$value": null,
   "$description": "No logo yet: render brand.name in title style."
  }
 },
